+#include "Common/CemuProf.h"
+#include "Cafe/OS/RPL/rpl_symbol_storage.h"
+#include <pthread.h>
+#include <map>
+#include <tuple>
+
+// ---- CEMU_CORE_STATS=1: per emulated core idle/blocker attribution (cpu agent) ----
+// Everything here is only touched while the scheduler lock is held.
+namespace cstat
+{
+	struct Agg { uint64 ticks = 0; uint32 count = 0; };
+	struct CoreState
+	{
+		uint64 idleStart = 0;
+		uint64 runStart = 0;
+		MPTR runThread = 0;
+		// what the thread that last left this core was doing
+		MPTR blkThread = 0; uint32 blkPC = 0; uint32 blkLR = 0; bool blkWaiting = false;
+		std::string waker;
+		bool idling = false;
+		std::map<std::tuple<uint32, uint32, uint32, std::string>, Agg> idleBy; // (thread, pc, lr, waker)
+		std::map<MPTR, Agg> runBy;
+		uint64 idleTotal = 0;
+	};
+	CoreState s_core[3];
+	uint64 s_lastDump = 0;
+	struct ThrState { uint32 pc = 0, lr = 0; bool waiting = false; std::string waker; };
+	std::map<MPTR, ThrState> s_thr;
+	MPTR s_primary[3]{}; // busiest guest thread per core in the previous window; idle time is attributed to its wait
+
+	static const char* hostName()
+	{
+		thread_local char name[20] = {};
+		if (!name[0])
+			pthread_getname_np(pthread_self(), name, sizeof(name));
+		return name;
+	}
+
+	static std::string guestThreadName(MPTR t)
+	{
+		if (!t)
+			return "-";
+		OSThread_t* th = (OSThread_t*)memory_getPointerFromVirtualOffset(t);
+		const char* n = th->threadName.GetPtr();
+		return n ? std::string(n) : fmt::format("thr_{:08x}", t);
+	}
+
+	static std::string symAt(uint32 pc)
+	{
+		if (!pc)
+			return "-";
+		RPLStoredSymbol* s = rplSymbolStorage_getByAddress(pc);
+		if (s)
+			return fmt::format("{}.{}", (const char*)s->libName, (const char*)s->symbolName);
+		return fmt::format("{:08x}", pc);
+	}
+
+	void runEnd(uint32 core, MPTR thread)
+	{
+		CoreState& c = s_core[core];
+		if (c.runStart && c.runThread == thread)
+		{
+			Agg& a = c.runBy[thread];
+			a.ticks += cprof::ticks() - c.runStart;
+			a.count++;
+		}
+		c.runStart = 0;
+	}
+
+	void runBegin(uint32 core, MPTR thread)
+	{
+		CoreState& c = s_core[core];
+		c.runStart = cprof::ticks();
+		c.runThread = thread;
+	}
+
+	// current thread leaves the core (blocked or time slice over)
+	void switchOut(uint32 core, OSThread_t* thread, PPCInterpreter_t* hCPU)
+	{
+		MPTR t = memory_getVirtualOffsetFromPointer(thread);
+		runEnd(core, t);
+		CoreState& c = s_core[core];
+		c.blkThread = t;
+		c.blkWaiting = thread->state != OSThread_t::THREAD_STATE::STATE_RUNNING;
+		c.blkPC = c.blkWaiting ? hCPU->instructionPointer : 0;
+		c.blkLR = c.blkWaiting ? hCPU->spr.LR : 0;
+		ThrState& ts = s_thr[t];
+		ts.waiting = c.blkWaiting; ts.pc = c.blkPC; ts.lr = c.blkLR; ts.waker.clear();
+	}
+
+	void idleBegin(uint32 core)
+	{
+		CoreState& c = s_core[core];
+		c.idleStart = cprof::ticks();
+		c.idling = true;
+		c.waker.clear();
+	}
+
+	void dump();
+
+	void idleEnd(uint32 core, OSThread_t* next)
+	{
+		CoreState& c = s_core[core];
+		uint64 now = cprof::ticks();
+		if (c.idling && c.idleStart)
+		{
+			uint64 d = now - c.idleStart;
+			MPTR nextT = memory_getVirtualOffsetFromPointer(next);
+			MPTR prim = s_primary[core];
+			std::tuple<uint32, uint32, uint32, std::string> key;
+			auto pit = prim ? s_thr.find(prim) : s_thr.end();
+			if (pit != s_thr.end() && (pit->second.waiting || nextT == prim))
+			{
+				// attribute to what the core's main thread was waiting for
+				if (nextT == prim)
+					key = std::make_tuple(prim, pit->second.pc, pit->second.lr, pit->second.waiting ? pit->second.waker : std::string("timeslice"));
+				else
+					key = std::make_tuple(prim, pit->second.pc, pit->second.lr, std::string("(still waiting; ran ") + guestThreadName(nextT) + ")");
+			}
+			else
+			{
+				MPTR bt = c.blkWaiting ? c.blkThread : 0;
+				key = std::make_tuple(bt, c.blkPC, c.blkLR, c.blkWaiting ? c.waker : std::string("timeslice"));
+			}
+			// short idles (thread still runnable, normal main-core time slice switch) collapse into one key
+			Agg& a = c.idleBy[key];
+			a.ticks += d;
+			a.count++;
+			c.idleTotal += d;
+		}
+		c.idling = false;
+		runBegin(core, memory_getVirtualOffsetFromPointer(next));
+		if (core == 1)
+		{
+			if (!s_lastDump)
+				s_lastDump = now;
+			else if (now - s_lastDump > cprof::freq() * 5)
+				dump();
+		}
+	}
+
+	// thread becomes runnable: remember who woke an idle core
+	void onReady(OSThread_t* thread, uint32 core)
+	{
+		CoreState& c = s_core[core];
+		MPTR t = memory_getVirtualOffsetFromPointer(thread);
+		bool isPrim = t == s_primary[core];
+		if ((!c.idling || !c.waker.empty()) && !isPrim)
+			return;
+		std::string w = hostName();
+		PPCInterpreter_t* cur = PPCInterpreter_getCurrentInstance();
+		if (cur)
+		{
+			OSThread_t* wt = coreinit::OSGetCurrentThread();
+			if (wt)
+				w += fmt::format(":{}@{:08x}", guestThreadName(memory_getVirtualOffsetFromPointer(wt)), cur->spr.LR);
+		}
+		if (c.idling && c.waker.empty())
+			c.waker = w;
+		if (isPrim)
+		{
+			ThrState& ts = s_thr[t];
+			if (ts.waker.empty())
+				ts.waker = w;
+		}
+	}
+
+	void dump()
+	{
+		uint64 now = cprof::ticks();
+		double wallMs = (double)(now - s_lastDump) * 1000.0 / (double)cprof::freq();
+		double tk2ms = 1000.0 / (double)cprof::freq();
+		s_lastDump = now;
+		for (uint32 core = 0; core < 3; core++)
+		{
+			CoreState& c = s_core[core];
+			uint64 runTotal = 0;
+			for (auto& it : c.runBy) runTotal += it.second.ticks;
+			cemuLog_log(LogType::Force, "[corestats] core{} wall={:.0f}ms run={:.1f}% idle={:.1f}%", core, wallMs, 100.0 * runTotal * tk2ms / wallMs, 100.0 * c.idleTotal * tk2ms / wallMs);
+			std::vector<std::pair<uint64, MPTR>> runs;
+			for (auto& it : c.runBy) runs.emplace_back(it.second.ticks, it.first);
+			std::sort(runs.rbegin(), runs.rend());
+			if (!runs.empty())
+				s_primary[core] = runs[0].second;
+			for (size_t i = 0; i < runs.size() && i < 8; i++)
+				cemuLog_log(LogType::Force, "[corestats]   run {:5.1f}% {}", 100.0 * runs[i].first * tk2ms / wallMs, guestThreadName(runs[i].second));
+			std::vector<std::pair<uint64, decltype(c.idleBy)::const_iterator>> idles;
+			for (auto it = c.idleBy.cbegin(); it != c.idleBy.cend(); ++it) idles.emplace_back(it->second.ticks, it);
+			std::sort(idles.begin(), idles.end(), [](auto& a, auto& b) { return a.first > b.first; });
+			for (size_t i = 0; i < idles.size() && i < 14; i++)
+			{
+				auto& k = idles[i].second->first;
+				cemuLog_log(LogType::Force, "[corestats]   idle {:5.1f}% n={} after {} blocked in {} lr={:08x} woken by {}", 100.0 * idles[i].first * tk2ms / wallMs, idles[i].second->second.count,
+					guestThreadName(std::get<0>(k)), symAt(std::get<1>(k)), std::get<2>(k), std::get<3>(k));
+			}
+			c.runBy.clear();
+			c.idleBy.clear();
+			c.idleTotal = 0;
+			if (c.runStart) c.runStart = now; // keep current slice but restart its accounting
+		}
+	}
+}
+
+namespace cprof
+{
+	void latteFrameTick()
+	{
+		static uint64 s_last = 0;
+		static uint64 s_lastVals[L_COUNT]{};
+		static uint32 s_frames = 0;
+		static uint64 s_lastCpuNs = 0;
+		if (!enabled())
+			return;
+		uint64 now = ticks();
+		static uint64 s_prevSwap = 0;
+		static uint32 s_hist[16]{}; // swap-to-swap interval histogram, 5 ms buckets
+		if (s_prevSwap)
+		{
+			uint64 b = (now - s_prevSwap) * 200 / freq();
+			s_hist[b < 15 ? b : 15]++;
