diff --git a/src/Common/CemuProf.h b/src/Common/CemuProf.h
new file mode 100644
index 0000000..c13829f
--- /dev/null
+++ b/src/Common/CemuProf.h
@@ -0,0 +1,64 @@
+#pragma once
+// Lightweight, env-gated profiling counters for the ARM Frame build (cpu agent, 2026-10-28).
+// CEMU_CORE_STATS=1 enables: per-core idle/blocker attribution (coreinit_Thread.cpp) and LatteThread wait accounting.
+// All timestamps use the ARM generic timer (cntvct_el0), which is what __rdtsc() maps to on aarch64.
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+namespace cprof
+{
+	inline uint64_t ticks()
+	{
+#if defined(__aarch64__)
+		uint64_t t;
+		asm volatile("mrs %0, cntvct_el0" : "=r"(t));
+		return t;
+#else
+		return __rdtsc();
+#endif
+	}
+
+	inline uint64_t freq()
+	{
+#if defined(__aarch64__)
+		static uint64_t f = []() { uint64_t v; asm volatile("mrs %0, cntfrq_el0" : "=r"(v)); return v; }();
+		return f;
+#else
+		return 1000000000ull; // not meaningful on x86; profiling is meant for the ARM build
+#endif
+	}
+
+	inline bool enabled()
+	{
+		static const bool on = []() { const char* e = getenv("CEMU_CORE_STATS"); return e && e[0] == '1'; }();
+		return on;
+	}
+
+	enum LatteCat
+	{
+		L_RING_IDLE,   // ring buffer empty: GPU thread waits for the guest CPU to submit commands
+		L_FENCE,       // WAIT_REG_MEM: GPU thread waits for a guest memory value
+		L_FLIP,        // HLE wait-for-flip
+		L_VKFENCE,     // vkWaitForFences on a submitted command buffer (waits for the real GPU)
+		L_SWAP,        // VulkanRenderer::SwapBuffers total (includes present / VR layer)
+		L_READBACK,    // texture readback / async waits
+		L_COUNT
+	};
+	inline std::atomic<uint64_t> g_latte[L_COUNT]{};
+	inline const char* latteCatName(int i)
+	{
+		static const char* n[] = {"ringIdle", "fenceWait", "flipWait", "vkFence", "swap", "readback"};
+		return n[i];
+	}
+
+	struct LatteScope
+	{
+		int cat; uint64_t t0;
+		LatteScope(int c) : cat(c), t0(enabled() ? ticks() : 0) {}
+		~LatteScope() { if (t0) g_latte[cat].fetch_add(ticks() - t0, std::memory_order_relaxed); }
+	};
+
+	// called once per frame from LatteThread (swap); logs every ~5 s
+	void latteFrameTick();
+}
