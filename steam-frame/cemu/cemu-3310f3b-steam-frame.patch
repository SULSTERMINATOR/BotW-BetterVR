+// BetterVR fixed foveated rendering (VK_EXT_fragment_density_map)
+// The density map is sampled by the driver per tile. Full density in an ellipse around the optical
+// centre (both eyes render into the same targets, so it has to cover both centres), half density
+// in a ring around it and quarter density at the edges. Tunable via CEMU_FDM_INNER / CEMU_FDM_OUTER
+// (ellipse radii as a fraction of the framebuffer) and CEMU_FDM_CENTER_Y.
+
+bool VulkanRenderer::FOV_IsTargetFramebuffer(Vector2i size, bool hasColorAttachment) const
+{
+	return (m_fdm.enabled || m_fdm.vrsCeilingRate > 1) && hasColorAttachment && size.x == m_fdm.targetSize.x && size.y == m_fdm.targetSize.y;
+}
+
+bool VulkanRenderer::FDM_UseForFramebuffer(Vector2i size, bool hasColorAttachment) const
+{
+	return m_fdm.enabled && hasColorAttachment && size.x == m_fdm.targetSize.x && size.y == m_fdm.targetSize.y;
+}
+
+static float FDM_GetEnvFloat(const char* name, float defaultValue)
+{
+	const char* value = std::getenv(name);
+	return value ? (float)atof(value) : defaultValue;
+}
+
+VkImageView VulkanRenderer::FDM_GetMapView(Vector2i size)
+{
+	for (auto& map : m_fdm.maps)
+	{
+		if (map.size.x == size.x && map.size.y == size.y)
+			return map.view;
+	}
+
+	FDMMap map{};
+	map.size = size;
+	const uint32 mapWidth = (size.x + m_fdm.texelSize.width - 1) / m_fdm.texelSize.width;
+	const uint32 mapHeight = (size.y + m_fdm.texelSize.height - 1) / m_fdm.texelSize.height;
+
+	VkImageCreateInfo imageInfo{ VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+	imageInfo.imageType = VK_IMAGE_TYPE_2D;
+	imageInfo.format = VK_FORMAT_R8G8_UNORM;
+	imageInfo.extent = { mapWidth, mapHeight, 1 };
+	imageInfo.mipLevels = 1;
+	imageInfo.arrayLayers = 1;
+	imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+	imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+	imageInfo.usage = VK_IMAGE_USAGE_FRAGMENT_DENSITY_MAP_BIT_EXT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	if (vkCreateImage(m_logicalDevice, &imageInfo, nullptr, &map.image) != VK_SUCCESS)
+		throw std::runtime_error("BetterVR FDM: failed to create density map image");
+
+	VkMemoryRequirements memReq;
+	vkGetImageMemoryRequirements(m_logicalDevice, map.image, &memReq);
+	uint32 memoryIndex = 0;
+	if (!memoryManager->FindMemoryType(memReq.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, memoryIndex))
+		throw std::runtime_error("BetterVR FDM: no device local memory for density map");
+	VkMemoryAllocateInfo allocInfo{ VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+	allocInfo.allocationSize = memReq.size;
+	allocInfo.memoryTypeIndex = memoryIndex;
+	if (vkAllocateMemory(m_logicalDevice, &allocInfo, nullptr, &map.memory) != VK_SUCCESS)
+		throw std::runtime_error("BetterVR FDM: failed to allocate density map memory");
+	vkBindImageMemory(m_logicalDevice, map.image, map.memory, 0);
+
+	VkImageViewCreateInfo viewInfo{ VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+	viewInfo.image = map.image;
+	viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+	viewInfo.format = VK_FORMAT_R8G8_UNORM;
+	viewInfo.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	if (vkCreateImageView(m_logicalDevice, &viewInfo, nullptr, &map.view) != VK_SUCCESS)
+		throw std::runtime_error("BetterVR FDM: failed to create density map view");
+
+	// fill the density pattern via a staging buffer (kept alive since the copy is recorded into the current command buffer)
+	const VkDeviceSize dataSize = (VkDeviceSize)mapWidth * mapHeight * 2;
+	memoryManager->CreateBuffer(dataSize, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, map.stagingBuffer, map.stagingMemory);
+	uint8* data = nullptr;
+	vkMapMemory(m_logicalDevice, map.stagingMemory, 0, dataSize, 0, (void**)&data);
+	const float inner = FDM_GetEnvFloat("CEMU_FDM_INNER", 0.33f);
+	const float outer = FDM_GetEnvFloat("CEMU_FDM_OUTER", 0.55f);
+	const float centerY = FDM_GetEnvFloat("CEMU_FDM_CENTER_Y", 0.45f);
+	uint32 counts[3]{};
+	for (uint32 y = 0; y < mapHeight; y++)
+	{
+		for (uint32 x = 0; x < mapWidth; x++)
+		{
+			const float u = ((float)x + 0.5f) / (float)mapWidth - 0.5f;
+			const float v = ((float)y + 0.5f) / (float)mapHeight - centerY;
+			const float r = std::sqrt(u * u + v * v);
+			uint8 density = 255; // 1.0 = full resolution
+			if (r > outer) { density = 64; counts[2]++; } // 0.25 = 4x4 pixels per fragment
+			else if (r > inner) { density = 128; counts[1]++; } // 0.5 = 2x2 pixels per fragment
+			else counts[0]++;
+			data[(y * mapWidth + x) * 2 + 0] = density;
+			data[(y * mapWidth + x) * 2 + 1] = density;
+		}
+	}
+	vkUnmapMemory(m_logicalDevice, map.stagingMemory);
+
+	draw_endRenderPass();
+	VkCommandBuffer cmd = m_state.currentCommandBuffer;
+	VkImageMemoryBarrier barrier{ VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+	barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.image = map.image;
+	barrier.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barrier.srcAccessMask = 0;
+	barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+	VkBufferImageCopy region{};
+	region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.imageExtent = { mapWidth, mapHeight, 1 };
+	vkCmdCopyBufferToImage(cmd, map.stagingBuffer, map.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barrier.newLayout = VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT;
+	barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	barrier.dstAccessMask = VK_ACCESS_FRAGMENT_DENSITY_MAP_READ_BIT_EXT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_DENSITY_PROCESS_BIT_EXT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+
+	cemuLog_log(LogType::Force, "BetterVR FDM: created {}x{} density map for {}x{} framebuffers (full={} half={} quarter={} texels)", mapWidth, mapHeight, size.x, size.y, counts[0], counts[1], counts[2]);
+	m_fdm.maps.emplace_back(map);
+	return map.view;
+}
