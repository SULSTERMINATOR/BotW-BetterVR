+// The Steam Frame reports a slightly different per-eye FOV on almost every xrLocateViews call
+// (+-1-2 degrees). The game renders with the FOV from one sample while the layer is submitted with
+// another, so the world visibly scales/warps from frame to frame. Latch the first FOV per eye and
+// use it everywhere; the runtime reprojects a fixed FOV correctly.
+// Overscan: render (and submit) a wider FOV than the display shows, so the compositor's reprojection
+// of a stale frame at low game FPS has image to show at the edges instead of black.
+// BETTERVR_LINUX_OVERSCAN=<tangent scale>, e.g. 1.15; 1 or unset disables it.
+static void LinuxOverscanViewFovs(std::array<XrView, 2>& views) {
+    static const float s_scale = [] {
+        const char* e = getenv("BETTERVR_LINUX_OVERSCAN");
+        float scale = e ? strtof(e, nullptr) : 1.0f;
+        if (!(scale >= 1.0f && scale <= 2.0f)) scale = 1.0f;
+        Log::print<INFO>("Linux FOV overscan: {:.2f}", scale);
+        return scale;
+    }();
+    if (s_scale == 1.0f) return;
+    for (XrView& view : views) {
