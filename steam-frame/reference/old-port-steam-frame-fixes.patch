+    static std::atomic<int> s_logged = 0;
+    if (g_ppcTraceFrames.load() > 0 && s_logged++ < 40) {
+        Log::print<INFO>("[PPCTrace] gameCalcGate: this={:08X} x200={:08X} g63E64={} gF550={} gF564={} gC728={:08X}",
+            hCPU->gpr[30], hCPU->gpr[3], rd(0x10463E64), rd(0x1046F550), rd(0x1046F564), rd(0x1047C728));
+    }
+}
