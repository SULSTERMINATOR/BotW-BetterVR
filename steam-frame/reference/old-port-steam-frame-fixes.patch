+// Mono rendering (BETTERVR_LINUX_MONO=1): during gameplay the stereo patch skips the right eye's draw pass
+// and the Linux renderer submits the left eye's image and depth for both eyes, leaving the right eye to the
+// runtime's reprojection. Roughly halves the per-frame render cost. Loading screens and menus stay stereo:
+// loading stalls without the right eye pass.
+// r3 = 0 at the start of a frame: decides this frame, returns whether the previous frame skipped its right eye
+//        (and so has no right eye procDraw pending)
+// r3 = 1 before the right eye's calcDraw: returns whether this frame skips it
+std::atomic_bool CemuHooks::s_monoFrame = false;
+
+void CemuHooks::hook_IsMonoRender(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    static const bool s_enabled = [] { const char* e = getenv("BETTERVR_LINUX_MONO"); return e && e[0] == '1'; }();
+    if (hCPU->gpr[3] == 0) {
+        // BETTERVR_LINUX_PPC_TRACE=N: after N gameplay frames, log every PPC console line for 3 frames
+        static const int s_traceAt = [] { const char* e = getenv("BETTERVR_LINUX_PPC_TRACE"); return e ? atoi(e) : 0; }();
+        static int s_gameplayFrames = 0;
+        if (g_ppcTraceFrames.load() > 0) g_ppcTraceFrames--;
+        if (s_traceAt > 0 && !IsShowingMenu() && ++s_gameplayFrames == s_traceAt) g_ppcTraceFrames = 4;
+#ifndef _WIN32
+        WriteWatch::s_phase = 1;
+        if (g_ppcTraceFrames.load() == 4) WriteWatch::Start();
+        if (g_ppcTraceFrames.load() == 1) WriteWatch::StopAndReport();
+#endif
+        if (g_ppcTraceFrames.load() > 0) Log::print<INFO>("[PPCTrace] ===== frame start (mono={}) ====={}", s_monoFrame.load(), TraceWatch());
+        bool previous = s_monoFrame.load();
+        s_monoFrame = s_enabled && !IsShowingMenu();
+        static const bool s_keepTopDraw = [] { const char* e = getenv("BETTERVR_LINUX_MONO_KEEP_TOP"); return e && e[0] == '1'; }();
+        hCPU->gpr[3] = (previous && !s_keepTopDraw) ? 1 : 0;
+    }
+    else if (hCPU->gpr[3] == 4) {
+        // whether the current frame is mono (stored by the stereo patch for its draw request patch)
+        hCPU->gpr[3] = s_monoFrame.load() ? 1 : 0;
+    }
+    else if (hCPU->gpr[3] == 2) {
+        // eye side for the left eye's calcDraw (BETTERVR_LINUX_MONO_LEFT_CALC_SIDE=1 runs it as the right eye in mono frames)
+        static const bool s_asRight = [] { const char* e = getenv("BETTERVR_LINUX_MONO_LEFT_CALC_SIDE"); return e && e[0] == '1'; }();
+        static int s_monoFrames = 0;
+        s_monoFrames = s_monoFrame.load() ? s_monoFrames + 1 : 0;
+        hCPU->gpr[3] = (s_asRight && s_monoFrames > 600) ? 1 : 0; // only once gameplay has settled: boot crashes otherwise
+    }
+    else {
+        // 0 = right eye calcDraw, 1 = skip it, 2 = repeat the left eye's calcDraw (BETTERVR_LINUX_MONO_CALC2=left)
+        static const bool s_calc2Left = [] { const char* e = getenv("BETTERVR_LINUX_MONO_CALC2"); return e && std::string_view(e) == "left"; }();
+        // 3 = skip it but still switch to the right eye side (BETTERVR_LINUX_MONO_CALC2=side)
+        static const bool s_sideOnly = [] { const char* e = getenv("BETTERVR_LINUX_MONO_CALC2"); return e && std::string_view(e) == "side"; }();
+        if (!s_monoFrame.load()) hCPU->gpr[3] = 0;
+        else if (s_calc2Left) hCPU->gpr[3] = 2;
+        else if (s_sideOnly) hCPU->gpr[3] = 3;
+        else hCPU->gpr[3] = MonoKeepsRightCalc() ? 0 : 1;
+    }
+}
