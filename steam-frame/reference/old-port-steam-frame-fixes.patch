+// replaces `stw r0, 0x34(r1)` at 0x03A245A4 (model scene stage worker prologue: r3/r27 = scene, r4 = stage, r5 = slice, r6..r7 = range)
+void CemuHooks::hook_TraceStageArgs(PPCInterpreter_t* hCPU) {
