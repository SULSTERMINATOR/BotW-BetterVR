+        auto rd = [&](uint32_t off) { return __builtin_bswap32(*(uint32_t*)(mem + sc + off)); };
+        Log::print<INFO>("[PPCTrace] stage: scene={:08X} stage={} slice={} range={}..{} models(ac)={} collected(c4)={}",
+            sc, hCPU->gpr[4], (int32_t)hCPU->gpr[5], hCPU->gpr[6], hCPU->gpr[7], rd(0xac), rd(0xc4));
+    }
+}
