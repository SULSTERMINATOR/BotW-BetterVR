+// BETTERVR_LINUX_WATCH=<hex address>: big-endian u32 printed with each trace marker
+static std::string TraceWatch() {
+    static const uint32_t s_addr = [] { const char* e = getenv("BETTERVR_LINUX_WATCH"); return e ? (uint32_t)strtoul(e, nullptr, 16) : 0u; }();
+    if (s_addr == 0) return {};
+    uint32_t v = __builtin_bswap32(*(uint32_t*)(CemuHooks::s_memoryBaseAddress + s_addr));
+    return std::format(" watch[{:08X}]={}", s_addr, (int32_t)v);
+}
