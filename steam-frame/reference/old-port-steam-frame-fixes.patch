+// replaces `sth r31, 0xC(r26)` at 0x039E6FD4 (model unit draw dispatch: r31 = visible view count, 0 skips the push)
+void CemuHooks::hook_TraceVisibleCount(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    uint8_t* mem = (uint8_t*)s_memoryBaseAddress;
+    uint16_t v = (uint16_t)hCPU->gpr[31];
+    mem[hCPU->gpr[26] + 0xC] = v >> 8;
+    mem[hCPU->gpr[26] + 0xD] = v & 0xFF;
+    static std::atomic<int> s_logged = 0;
+    if (g_ppcTraceFrames.load() > 0 && s_logged++ < 300) {
+        Log::print<INFO>("[PPCTrace] visCount: unit={:08X} count={} r29={:08X} r25={:08X} r24={:08X}", hCPU->gpr[26], v, hCPU->gpr[29], hCPU->gpr[25], hCPU->gpr[24]);
+    }
+}
