+#ifndef _WIN32
+// BETTERVR_LINUX_WRITEWATCH=<hex address>[:<bytes>]: during the trace window, write-protect the guest page holding
+// that range and record the PPC context (IP, LR) of every write into it. Debugging aid for the mono rendering work.
+#include <signal.h>
+#include <sys/mman.h>
+#include <dlfcn.h>
+namespace WriteWatch {
+    struct Hit { uint32_t ip, lr, r3, offset; int phase; uint32_t oldValue; };
+    std::atomic<int> s_phase{0};
+    static uint8_t* s_page = nullptr;
+    static uintptr_t s_lo = 0, s_hi = 0;
+    static std::atomic<bool> s_armed{false}, s_active{false};
+    static struct sigaction s_prev = {};
+    static PPCInterpreter_t* (*s_getCpu)() = nullptr;
+    static Hit s_hits[4096];
+    static std::atomic<uint32_t> s_hitCount{0};
+
+    static void Handler(int sig, siginfo_t* info, void* uctx) {
+        uintptr_t a = (uintptr_t)info->si_addr;
+        if (s_page && a >= (uintptr_t)s_page && a < (uintptr_t)s_page + 4096) {
+            if (a >= s_lo && a < s_hi) {
+                uint32_t n = s_hitCount.fetch_add(1);
+                PPCInterpreter_t* cpu = s_getCpu ? s_getCpu() : nullptr;
+                if (n < 4096) s_hits[n] = { cpu ? cpu->instructionPointer : 0, cpu ? cpu->sprNew.LR : 0, cpu ? cpu->gpr[3] : 0, (uint32_t)(a - s_lo), s_phase.load(), __builtin_bswap32(*(uint32_t*)(a & ~(uintptr_t)3)) };
+            }
+            mprotect(s_page, 4096, PROT_READ | PROT_WRITE);
+            s_armed = false;
+            return;
+        }
+        if (s_prev.sa_flags & SA_SIGINFO) s_prev.sa_sigaction(sig, info, uctx);
+        else if (s_prev.sa_handler != SIG_DFL && s_prev.sa_handler != SIG_IGN) s_prev.sa_handler(sig);
+        else { signal(sig, SIG_DFL); raise(sig); }
+    }
+
+    static void Start() {
+        const char* e = getenv("BETTERVR_LINUX_WRITEWATCH");
+        if (!e || s_active.exchange(true)) return;
+        uint32_t guest = (uint32_t)strtoul(e, nullptr, 16);
+        const char* colon = strchr(e, ':');
+        uint32_t len = colon ? (uint32_t)strtoul(colon + 1, nullptr, 0) : 4;
+        s_lo = (uintptr_t)(CemuHooks::s_memoryBaseAddress + guest);
+        s_hi = s_lo + len;
+        s_page = (uint8_t*)(s_lo & ~(uintptr_t)4095);
+        s_getCpu = (PPCInterpreter_t* (*)())dlsym(RTLD_DEFAULT, "_Z33PPCInterpreter_getCurrentInstancev");
+        struct sigaction sa = {};
+        sa.sa_sigaction = Handler;
+        sa.sa_flags = SA_SIGINFO | SA_NODEFER;
+        sigemptyset(&sa.sa_mask);
+        sigaction(SIGSEGV, &sa, &s_prev);
+        std::thread([] {
+            while (s_active.load()) {
+                if (!s_armed.load()) {
+                    s_armed = true;
+                    mprotect(s_page, 4096, PROT_READ);
+                }
+                std::this_thread::sleep_for(std::chrono::microseconds(20));
+            }
+            mprotect(s_page, 4096, PROT_READ | PROT_WRITE);
+        }).detach();
+        Log::print<INFO>("[WriteWatch] watching {:08X}+{} (page {}), getCpu={}", guest, len, (void*)s_page, (void*)s_getCpu);
+    }
+
+    static void StopAndReport() {
+        if (!s_active.exchange(false)) return;
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        uint32_t n = std::min<uint32_t>(s_hitCount.load(), 4096);
+        std::map<std::tuple<uint32_t, uint32_t, uint32_t>, int> counts;
+        for (uint32_t i = 0; i < n; i++) counts[{ s_hits[i].ip, s_hits[i].lr, s_hits[i].offset }]++;
+        Log::print<INFO>("[WriteWatch] {} writes", s_hitCount.load());
+        for (uint32_t i = 0; i < std::min<uint32_t>(n, 80); i++)
+            Log::print<INFO>("[WriteWatch] #{} phase={} ip={:08X} lr={:08X} old={}", i, s_hits[i].phase, s_hits[i].ip, s_hits[i].lr, (int32_t)s_hits[i].oldValue);
+        for (auto& [k, c] : counts) Log::print<INFO>("[WriteWatch] ip={:08X} lr={:08X} offset=+{:X} x{}", std::get<0>(k), std::get<1>(k), std::get<2>(k), c);
+    }
+}
+#endif
