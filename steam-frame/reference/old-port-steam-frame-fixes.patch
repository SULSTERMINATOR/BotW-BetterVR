+// replaces `lbz r5, 4(r22)` at 0x039F1604 (draw item push: per-shape visibility byte, compared with the view's mask at 0xB(r15))
+void CemuHooks::hook_TraceVisibility(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    uint8_t* mem = (uint8_t*)s_memoryBaseAddress;
+    hCPU->gpr[5] = mem[hCPU->gpr[22] + 4];
+    static std::atomic<int> s_logged = 0;
+    if (g_ppcTraceFrames.load() > 0 && s_logged++ < 120) {
+        uint32_t r15 = hCPU->gpr[15];
+        Log::print<INFO>("[PPCTrace] vis: unit={:08X} shapeVis@{:08X}={:02X} viewMask={:02X} view={} r27={} r16={} r28={} r19={} items={:08X}",
+            hCPU->gpr[30], hCPU->gpr[22], hCPU->gpr[5], mem[r15 + 0xB], hCPU->gpr[16], hCPU->gpr[27], hCPU->gpr[16], hCPU->gpr[28], hCPU->gpr[19], r15);
+    }
+}
