+void CemuHooks::hook_TraceActorModelCalc(PPCInterpreter_t* hCPU) {
+    hCPU->instructionPointer = hCPU->sprNew.LR;
+    uint8_t* mem = (uint8_t*)s_memoryBaseAddress;
+    auto rd = [&](uint32_t a) { return __builtin_bswap32(*(uint32_t*)(mem + a)); };
